# Generate a local key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use db.sqlite3. Production requires a
# PostgreSQL URL provided as a Render environment variable.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Leave REDIS_URL unset locally to use the in-memory channel layer. Production
# requires a Redis-compatible service URL.
# REDIS_URL=rediss://USER:PASSWORD@HOST:PORT

# Optional production origins (comma-separated, including https://).
# Render's assigned hostname is trusted automatically.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
